NODE_ENV=development
PORT=3001

STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

VERIFICATION_CONTRACT_ID=C...

# Opcional. Quando definida, /v1/verify consulta a API publica do Guardian
# Seal (por codigo de barras) em vez do contrato Soroban proprio acima.
GUARDIAN_SEAL_BASE_URL=

X402_PRICE=$0.01
X402_PAY_TO=G...
# Segue o quickstart oficial da Stellar (docs atuais).
X402_FACILITATOR_URL=https://www.x402.org/facilitator
X402_FACILITATOR_API_KEY=

API_BASE_URL=http://localhost:3001

# Somente no cliente local de demonstração.
# Nunca commitar esta chave.
STELLAR_PRIVATE_KEY=S...
